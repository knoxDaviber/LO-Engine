  "required": [
    "damage",
    "guard",
    "matchup",
    "timeline",
    "pp",
    "board",
    "class_advantage",
    "stun_pushback_counts",
    "rolls",
    "class_traits",
    "phase",
    "draft",
    "limits",
    "cost"
  ],
  "additionalProperties": false
}