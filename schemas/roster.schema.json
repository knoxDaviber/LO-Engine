{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "roster_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "heroes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "char_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "squad_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "squad_row": {
            "type": "string",
            "enum": [
              "front",
              "back"
            ]
          },
          "equipment": {
            "type": "object",
            "properties": {
              "weapon": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "armor": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "accessory_1": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "accessory_2": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "weapon",
              "armor",
              "accessory_1",
              "accessory_2"
            ],
            "additionalProperties": false
          },
          "tactic_sheet": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "priority": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "skill_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "enabled": {
                  "type": "boolean"
                },
                "activation": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/__schema0"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "targeting": {
                  "type": "object",
                  "properties": {
                    "main": {
                      "anyOf": [
                        {
                          "$ref": "#/$defs/__schema0"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "sub": {
                      "anyOf": [
                        {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "select": {
                                  "type": "string",
                                  "enum": [
                                    "lowest",
                                    "highest",
                                    "nearest",
                                    "farthest",
                                    "random_seeded"
                                  ]
                                },
                                "type": {
                                  "type": "string"
                                },
                                "metric": {
                                  "type": "string"
                                },
                                "stat": {
                                  "type": "string",
                                  "enum": [
                                    "HP",
                                    "ATK",
                                    "INT",
                                    "DEF",
                                    "MDEF",
                                    "SPD",
                                    "HIT",
                                    "SKL",
                                    "CRIT",
                                    "GUARD",
                                    "EVA"
                                  ]
                                },
                                "side": {
                                  "type": "string",
                                  "enum": [
                                    "self",
                                    "ally",
                                    "enemy",
                                    "target"
                                  ]
                                }
                              },
                              "required": [
                                "select"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "$ref": "#/$defs/__schema0"
                            }
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "main",
                    "sub"
                  ],
                  "additionalProperties": false
                },
                "fallback": {
                  "type": "string",
                  "enum": [
                    "skip",
                    "next_valid_target"
                  ]
                }
              },
              "required": [
                "priority",
                "skill_id",
                "enabled",
                "activation",
                "targeting",
                "fallback"
              ],
              "additionalProperties": false
            }
          },
          "preferred_row": {
            "type": "string",
            "enum": [
              "front",
              "back"
            ]
          }
        },
        "required": [
          "char_id",
          "squad_id",
          "equipment",
          "tactic_sheet"
        ],
        "additionalProperties": false
      }
    },
    "leader_line": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "anchor": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "ban_sheet": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "priority": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "filter": {
                    "$ref": "#/$defs/__schema0"
                  },
                  "select": {
                    "type": "string",
                    "enum": [
                      "highest",
                      "lowest",
                      "nearest"
                    ]
                  },
                  "metric": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "priority",
                  "filter",
                  "select",
                  "metric"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "rules"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "roster_id",
    "version",
    "heroes",
    "leader_line",
    "anchor",
    "ban_sheet"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "all": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": {}
        }
      ]
    }
  }
}