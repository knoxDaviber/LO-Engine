{
  "name": "tactics-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Content schema and validator for the tactics auto-battler",
  "scripts": {
    "validate": "tsx src/cli.ts",
    "sim": "tsx src/sim.ts",
    "batch": "tsx src/batch.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p editor",
    "schema:export": "tsx src/exportSchemas.ts",
    "editor": "vite --config editor/vite.config.ts",
    "sprites": "node tools/sprites.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "*",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.5"
  }
}
